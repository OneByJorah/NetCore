# Docker Compose environment (root .env) — see backend/.env.example for full backend options

# Ports (change if 3000/8000 are already in use on your host)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
DATABASE_URL=sqlite:///./switches.db
# For PostgreSQL: DATABASE_URL=postgresql://user:***@postgres:5432/netara

# OpenAI / AI
OPENAI_API_KEY=<set-value>

# SSH Credentials (default for network devices)
SSH_USERNAME=admin
SSH_PASSWORD=<set-value>

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Frontend -> Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
