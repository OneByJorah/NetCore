# Keep the build context small and prevent local state/secrets from reaching the image.
node_modules
.next
out
build
dist

# Local env files — never bake these into an image
.env
.env.*
!.env.example

# VCS + tooling
.git
.gitignore
.github
*.md
Dockerfile*
docker-compose*.yml
.dockerignore

# Local databases and logs
*.db
*.db-shm
*.db-wal
*.log
__pycache__
*.pyc
.venv
venv
